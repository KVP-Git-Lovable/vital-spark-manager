/* Make only the sidebar widget area sticky */
.sidebar {
    position: sticky;
    top: 120px; /* adjust to match header height */
	align-self: flex-start;  
}

/* Make sure the TOC container does NOT override styling */
.ez-toc-widget-sticky-container {
    position: static !important;  /* remove EZ-TOC sticky */
    background: inherit !important; /* keep original background */
    max-height: none !important;
    overflow: visible !important;
    box-shadow: none !important;
    border-radius: 0 !important;
}

/* Card Style */
.service-card {
    background: #ffffff;
    padding: 25px;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.06);
}

/* Image Styling */
.service-card img {
    width: 100%;
    height: 250px;
    border-radius: 14px;
    object-fit: cover;
    margin-bottom: 18px;
}

/* Title Styling */
.service-card h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.3;
}

/* Paragraph */
.service-card p {
    color: #444;
    font-size: 15px;
    line-height: 1.6;
}

/* Fix overlapping columns */
.services-row {
    display: flex;
    gap: 30px; /* spacing between columns */
}

.services-row .wpb_column {
    padding: 0; /* remove heavy padding */
}

@media (max-width: 768px) {

    .services-row {
        flex-direction: column; /* stack the cards vertically */
        gap: 20px;
    }

    .service-card {
        padding: 18px; /* slightly smaller padding */
    }

    .service-card img {
        height: 180px; /* reduce image height */
    }

    .service-card h3 {
        font-size: 18px;
    }

    .service-card p {
        font-size: 14px;
    }
}

/* Always show overlay */
.twentytwenty-overlay {
    opacity: 1 !important;
    background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.45) 0%,
        rgba(0, 0, 0, 0.15) 50%,
        rgba(0, 0, 0, 0.45) 100%
    );
}

/* Before & After label styling */
.twentytwenty-before-label,
.twentytwenty-after-label {
    font-size: 20px;            /* Bigger text */
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 10px 18px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 30px;
    text-transform: uppercase;
}
/* Force center position */
.twentytwenty-container .twentytwenty-handle {
    left: 50% !important;
    margin-left: -18px; /* half of handle width */
}


/* Position adjustment */
.twentytwenty-before-label {
    left: 20px;
}

.twentytwenty-after-label {
    right: 20px;
}

@media (max-width: 768px) {
    .twentytwenty-before-label,
    .twentytwenty-after-label {
        font-size: 15px;
        padding: 8px 14px;
    }

    .twentytwenty-handle {
        left: 50% !important;
    }
}


/*hiden hero section in skin clinic mangalore page*/
.page-id-3406 .sc_layouts_title,
.page-id-3406 .vc_empty_space {
    display: none !important;
}

.page-id-3406 .top_panel {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
}

.page-id-3406 .top_panel .vc_empty_space {
    display: none !important;
}

.page-id-3406 .sc_layouts_title {
    display: none !important;
}



